# Salin menjadi .env lalu sesuaikan.

# Alamat & port server Node (biarkan 127.0.0.1 bila di belakang Nginx)
HOST=127.0.0.1
PORT=3000

# Lokasi file database SQLite
DB_PATH=./data/brankas.db

# Pendaftaran akun:
#   first  = hanya akun pertama yang boleh daftar, lalu otomatis ditutup (default)
#   code   = boleh daftar bila memasukkan SIGNUP_CODE (untuk keluarga/tim)
#   open   = siapa saja boleh daftar
#   closed = pendaftaran ditutup
SIGNUP_MODE=first
SIGNUP_CODE=

# Lampiran: ukuran maksimal per file & kuota per akun (MB)
ATTACH_MAX_MB=25
ATTACH_QUOTA_MB=500

# Cloudflare Turnstile (verifikasi "bukan robot" di Masuk & Daftar). Kosongkan untuk menonaktifkan.
# Buat di dash.cloudflare.com -> Turnstile -> Add widget (hostname: domain Brankas).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lama sesi login (jam)
SESSION_HOURS=12

# true di produksi (HTTPS). false hanya untuk uji lokal lewat http://
COOKIE_SECURE=true

# Proxy yang dipercaya untuk membaca IP asli klien (Nginx di mesin yang sama = loopback)
TRUST_PROXY=loopback
